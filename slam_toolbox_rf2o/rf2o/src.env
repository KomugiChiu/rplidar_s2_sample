# Source of truth for this build recipe.
# Used by fetch.sh (sourced) and the Makefile (include) - keep plain KEY=VALUE.

# Upstream source ("SRC_URI git://...")
RF2O_GIT_URL=https://github.com/MAPIRlab/rf2o_laser_odometry.git
RF2O_BRANCH=ros2

# Pin ("SRCREV") - latest ros2 head as of 2026-11-20 (no upstream tags).
# Keep this a full commit SHA; fetch.sh refuses to fall back to the branch head.
RF2O_SRCREV=b38c68e46387b98845ecbfeb6660292f967a00d3

# Where `make install` stages the flat prefix when DESTDIR is not given.
RF2O_DESTDIR=/nvt_ros2_example/rf2o
